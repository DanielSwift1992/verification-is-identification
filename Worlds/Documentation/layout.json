  "tableStyle": [
    {
      "selector": ".content table, article table",
      "declarations": {
        "display": "block",
        "overflow-x": "auto",
        "max-width": "100%"
      }
    },
    {
      "selector": ".content th, article th",
      "declarations": {
        "cursor": {
          "layout": "TableSortCursor"
        },
        "white-space": "nowrap"
      }
    },
    {
      "selector": ".content th::after, article th::after",
      "declarations": {
        "content": "' \\2195'",
        "opacity": {
          "layout": "TableSortHintOpacity"
        },
        "font-size": {
          "layout": "TableSortHintSize"
        }
      }
    },
    {
      "selector": ".content th:hover, article th:hover",
      "declarations": {
        "background": {
          "role": "SurfaceTrack"
        }
      }
    },
    {
      "selector": ".content th[data-vi-sort=down]::after, article th[data-vi-sort=down]::after",
      "declarations": {
        "content": "' \\2193'",
        "opacity": {
          "layout": "TableSortActiveOpacity"
        }
      }
    },
    {
      "selector": ".content th[data-vi-sort=up]::after, article th[data-vi-sort=up]::after",
      "declarations": {
        "content": "' \\2191'",
        "opacity": {
          "layout": "TableSortActiveOpacity"
        }
      }
    }
  ],
