import Std

namespace U5

/-- A finite product; every leaf is an occurrence, not a payload constant. -/
inductive Term (α : Type) where
  | leaf : α → Term α
  | pair : Term α → Term α → Term α
  deriving DecidableEq, Repr

abbrev Path := List Bool -- false = Left, true = Right
abbrev SortId := Nat      -- exact interned sort identities, not payload values

namespace Term

def map (f : α → β) : Term α → Term β
  | .leaf a => .leaf (f a)
  | .pair l r => .pair (map f l) (map f r)

def lookup : Term α → Path → Option α
  | .leaf a, [] => some a
  | .pair l _, false :: p => lookup l p
  | .pair _ r, true :: p => lookup r p
  | _, _ => none

/-- Payloads in left-to-right occurrence order; duplicates are retained. -/
def values : Term α → List α
  | .leaf a => [a]
  | .pair l r => values l ++ values r

def entries : Term α → List (Path × α)
  | .leaf a => [([], a)]
  | .pair l r =>
      (entries l).map (fun (p, a) => (false :: p, a)) ++
      (entries r).map (fun (p, a) => (true :: p, a))

@[simp] theorem lookup_map (f : α → β) (t : Term α) (p : Path) :
    (t.map f).lookup p = (t.lookup p).map f := by
  induction t generalizing p with
  | leaf a => cases p <;> simp [map, lookup]
  | pair l r ihl ihr =>
    cases p with
    | nil => rfl
    | cons b p => cases b <;> simp [map, lookup, ihl, ihr]

theorem mem_entries {t : Term α} {p : Path} {a : α} :
    (p, a) ∈ t.entries ↔ t.lookup p = some a := by
  induction t generalizing p with
  | leaf b => cases p <;> simp [entries, lookup, eq_comm]
  | pair l r ihl ihr =>
    cases p with
    | nil => simp [entries, lookup]
    | cons b p => cases b <;> simp [entries, lookup, ihl, ihr]

theorem mem_values_of_lookup {t : Term α} {p : Path} {a : α}
    (h : t.lookup p = some a) : a ∈ t.values := by
  induction t generalizing p with
  | leaf b => cases p <;> simp_all [lookup, values]
  | pair l r ihl ihr =>
    cases p with
    | nil => simp [lookup] at h
    | cons b p =>
      cases b
      · exact List.mem_append_left _ (ihl h)
      · exact List.mem_append_right _ (ihr h)

theorem map_eq_of_values (t : Term α) (f g : α → β)
    (h : ∀ a ∈ t.values, f a = g a) : t.map f = t.map g := by
  induction t with
  | leaf a => simp [map, h a (by simp [values])]
  | pair l r ihl ihr =>
    simp only [map]
    congr 1
    · exact ihl (fun a ha => h a (by simp [values, ha]))
    · exact ihr (fun a ha => h a (by simp [values, ha]))

end Term

structure Edge where
  address : Path
  left : Path
  right : Path
  deriving DecidableEq, Repr

structure Model where
  source : Term SortId
  observation : Term Path
  question : Term Path
  edges : List Edge
  deriving Repr

/-- Finite admission of the already normalized U3 record, not a Swift reader. -/
def Model.valid (m : Model) : Bool :=
  (m.observation.values ++ m.question.values).all (fun p => (m.source.lookup p).isSome) &&
  m.edges.all (fun e => (m.source.lookup e.left).isSome &&
    m.source.lookup e.left == m.source.lookup e.right) &&
  decide (m.edges.map Edge.address).Nodup

/-- The relation generated by the declared E-edges. -/
inductive Closure (edges : List Edge) : Path → Path → Prop where
  | refl (p) : Closure edges p p
  | edge {e} : e ∈ edges → Closure edges e.left e.right
  | symm {p q} : Closure edges p q → Closure edges q p
  | trans {p q r} : Closure edges p q → Closure edges q r → Closure edges p r

/-- The generated relation is the least equivalence containing the E-edges. -/
theorem closure_minimal {edges : List Edge} (r : Path → Path → Prop)
    (hrefl : ∀ p, r p p) (hsymm : ∀ {p q}, r p q → r q p)
    (htrans : ∀ {p q t}, r p q → r q t → r p t)
    (hedge : ∀ e ∈ edges, r e.left e.right) {p q}
    (h : Closure edges p q) : r p q := by
  induction h with
  | refl p => exact hrefl p
  | edge he => exact hedge _ he
  | symm _ ih => exact hsymm ih
  | trans _ _ ih₁ ih₂ => exact htrans ih₁ ih₂

/-- Opaque sorts are arbitrary nonempty subsets of one ambient carrier.
Any family of nonempty carrier types embeds in its disjoint union. -/
structure Interpretation (α : Type) where
  carrier : SortId → α → Prop
  inhabited : ∀ s, ∃ a, carrier s a

/-- Every nonempty family of carrier types has an interpretation of this form;
no bound on the cardinality of a sort is imposed. -/
noncomputable def interpretationOfFamily (family : SortId → Type)
    (inhabited : ∀ s, Nonempty (family s)) : Interpretation (Sigma family) where
  carrier s value := value.1 = s
  inhabited s := ⟨⟨s, Classical.choice (inhabited s)⟩, rfl⟩

def Compatible (m : Model) (x : Path → α) : Prop :=
  ∀ e ∈ m.edges, x e.left = x e.right

def Typed (m : Model) (i : Interpretation α) (x : Path → α) : Prop :=
  ∀ p s, m.source.lookup p = some s → i.carrier s (x p)

def Gamma (m : Model) (i : Interpretation α) (x : Path → α) : Prop :=
  Typed m i x ∧ Compatible m x

theorem closure_sound {m : Model} {x : Path → α} (hx : Compatible m x)
    {p q} (h : Closure m.edges p q) : x p = x q := by
  induction h with
  | refl => rfl
  | edge he => exact hx _ he
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Separate from checker soundness: the compatible class is not vacuous. -/
theorem compatible_nonempty (m : Model) (hm : m.valid = true)
    (i : Interpretation α) : ∃ x, Gamma m i x := by
  classical
  let choose := fun s => Classical.choose (i.inhabited s)
  let x := fun p => choose ((m.source.lookup p).getD 0)
  refine ⟨x, ?_, ?_⟩
  · intro p s hs
    simpa [x, hs, choose] using Classical.choose_spec (i.inhabited s)
  · intro e he
    have hedge : (m.source.lookup e.left).isSome = true ∧
        m.source.lookup e.left = m.source.lookup e.right := by
      simp only [Model.valid, Bool.and_eq_true_iff, List.all_eq_true, beq_iff_eq, decide_eq_true_eq] at hm
      exact hm.1.2 e he
    simp [x, hedge.2]

end U5
